{
  "name": "ai-defense-rts",
  "version": "0.1.0",
  "private": true,
  "description": "Original offline single-player desktop RTS: defensive AI agents vs network invaders",
  "main": "dist-electron/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "bake:materials": "npm run build && BAKE_MATERIALS=public/assets/materials npx electron .",
    "dist": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.aidefenserts.game",
    "productName": "AI Defense RTS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
